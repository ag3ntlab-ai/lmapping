generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Lead {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String   @unique
  source        String?
  consentAt     DateTime @default(now())
  noticeVersion String
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
